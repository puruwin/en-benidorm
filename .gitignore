node_modules/
dist/
sanity-dist/
.astro/
.env
.env.*
!.env.example
schema.json
*.log

# Runtime state and regenerable content-pipeline artifacts.
/content/discovered/*.json
/content/enriched/*.json
/content/comparisons/candidates/*.json
/content/comparisons/enriched/*.json
/content/generated/.staging/**/*.json
/content/reports/*
!/content/reports/.gitkeep
!/content/reports/discovery-coverage/
!/content/reports/discovery-coverage/latest.json
!/content/reports/discovery-coverage/latest.md
!/content/reports/comparisons/
/content/reports/comparisons/*
!/content/reports/comparisons/.gitkeep
/content/manifest.json
/content/discovery/checkpoints/*.json

# Private Content Lab deployment configuration.
/deploy/content-lab/*.env

# Caché de 24 h de las API de imágenes (scripts/images/lib/cache.ts).
/content/images/.cache/

# Runtime del Studio que regenera cada `sanity build`/`sanity dev`.
.sanity/
