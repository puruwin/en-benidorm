    {
      "_type": "block",
      "style": "normal",
      "markDefs": [],
      "children": [
        {
          "_type": "span",
          "marks": [],
          "text": "Una carta de orientación italiana y mediterránea con pasta, pizza y focaccia. El establecimiento permite reservar y también dispone de servicio para llevar."
        }
      ]
    },
    {
      "_type": "block",
      "style": "h2",
      "markDefs": [],
