---
import Breadcrumbs from '../../components/Breadcrumbs.astro'
import Sources from '../../components/Sources.astro'
import BaseLayout from '../../layouts/BaseLayout.astro'
import {factLabel, factValue, findFact, formatRetrievedAt, latestRetrievedAt, pendingText} from '../../lib/beach-presentation'
import {getBeachesContent} from '../../lib/content-source'
import {structuralIndexability} from '../../lib/indexability'
import {HUBS, breadcrumbTrail, getRouteRegistry} from '../../lib/routes'
import type {SourceItem} from '../../types/content'

const content = await getBeachesContent()
const breadcrumbs = breadcrumbTrail(null, HUBS.beaches.label, await getRouteRegistry())

// Columnas de la visión general: solo datos que separan una playa de otra. Salen de los hechos de cada ficha.
const columns = [
  {label: 'Longitud', attribute: 'longitud', citeTitle: false},
  {label: 'Socorrismo', attribute: 'socorrismo', citeTitle: false},
  {label: 'Aseos', attribute: 'aseos', citeTitle: false},
  {label: 'Punto accesible', attribute: 'punto-accesible', citeTitle: false},
  {label: 'Aparcamiento documentado en la zona', attribute: 'aparcamiento-cercano', citeTitle: true},
] as const
const rows = content.beaches.map((beach) => ({beach, cells: columns.map((column) => ({column, fact: findFact(beach, column.attribute)}))}))

// Lo que es igual en todas: se dice una vez, con la fuente de cada playa.
const shared = ['bandera-azul', 'arena', 'perros'].flatMap((attribute) => {
  const facts = content.beaches.map((beach) => ({beach, fact: findFact(beach, attribute)}))
  const values = new Set(facts.map(({fact}) => fact && factValue(fact)))
  const first = facts[0]?.fact
  return first && values.size === 1 && factValue(first) ? [{label: factLabel(first), value: factValue(first)!, facts}] : []
})

const updated = latestRetrievedAt(content.beaches)
const sources = [...new Map(content.beaches.flatMap((beach) => beach.sources).map((source): [string, SourceItem] => [source.url, source])).values()]
---

<BaseLayout seo={content.seo} indexability={structuralIndexability({subject: HUBS.beaches.label, h1: content.title, storedNoIndex: content.seo.noIndex, title: content.seo.title})} breadcrumbs={breadcrumbs}>
  <header class="bg-sand py-10 md:py-16">
    <div class="container-site">
      <Breadcrumbs items={breadcrumbs} />
      <p class="mt-12 text-xs font-black uppercase tracking-[.18em] text-coral">Elegir playa</p>
      <h1 class="font-editorial mt-2 max-w-4xl text-5xl leading-[.98] tracking-[-.045em] md:text-7xl">{content.title}</h1>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-ink/70">{content.intro}</p>
      {updated && <p class="mt-6 inline-flex rounded-full bg-sky px-4 py-2 text-xs font-bold text-sea-dark">Datos municipales consultados el&nbsp;<time datetime={updated.slice(0, 10)}>{formatRetrievedAt(updated)}</time></p>}
    </div>
  </header>

  <section class="py-14 md:py-20" aria-labelledby="choose-title">
    <div class="container-site">
      <h2 id="choose-title" class="font-editorial text-3xl md:text-4xl">Qué playa elegir según lo que buscas</h2>
      <ul class="mt-7 grid gap-4 md:grid-cols-3">{content.beaches.map((beach) => <li class="rounded-2xl border border-ink/10 bg-white p-6 shadow-[0_12px_40px_rgba(16,47,59,.05)]">
        <h3 class="font-editorial text-2xl"><a class="text-sea-dark underline" href={beach.href}>{beach.name}</a></h3>
        <p class="mt-3 text-sm leading-relaxed text-ink/80">{beach.choiceNote ?? beach.shortDescription}</p>
      </li>)}</ul>
      <p class="mt-6 max-w-3xl text-sm text-ink/60">Afluencia, ambiente y facilidad real para aparcar no los hemos comprobado en persona en ninguna de las tres; cada ficha lo marca como pendiente.</p>
    </div>
  </section>

  <section class="pb-14 md:pb-20" aria-labelledby="overview-title">
    <div class="container-site">
      <h2 id="overview-title" class="font-editorial text-3xl md:text-4xl">Las tres playas, lado a lado</h2>
      <p class="mt-3 max-w-2xl text-ink/70">Los datos que más ayudan a elegir. Cada uno enlaza a su fuente; lo que no hemos podido confirmar queda marcado como pendiente. El aparcamiento de Poniente es el que una nota municipal sitúa en su zona: la nota no indica la distancia hasta la arena.</p>
      <div class="mt-8 overflow-x-auto rounded-2xl border border-ink/10 bg-white">
        <table class="w-full min-w-[56rem] text-left text-sm">
          <thead class="bg-sand/60 text-xs font-black uppercase tracking-[.1em] text-ink/60"><tr><th scope="col" class="p-4">Playa</th>{columns.map((column) => <th scope="col" class="p-4">{column.label}</th>)}</tr></thead>
          <tbody class="divide-y divide-ink/10">{rows.map(({beach, cells}) => <tr class="align-top">
            <th scope="row" class="p-4"><a class="font-editorial text-xl text-sea-dark underline" href={beach.href}>{beach.name}</a></th>
            {cells.map(({column, fact}) => <td class="p-4">{fact
              ? factValue(fact) ? <><span>{factValue(fact)}</span>{fact.sourceUrl && <a class="mt-1 block text-xs text-ink/50 underline" href={fact.sourceUrl} rel="noopener noreferrer">{column.citeTitle && fact.sourceTitle ? fact.sourceTitle : 'Fuente'}</a>}</> : <span class="font-bold text-coral">{pendingText(fact)}</span>
              : <span class="text-ink/40">Sin dato</span>}</td>)}
          </tr>)}</tbody>
        </table>
      </div>

      {shared.length > 0 && <div class="mt-8 rounded-2xl bg-sand/50 p-6">
        <h3 class="font-editorial text-2xl">Igual en las tres</h3>
        <dl class="mt-4 space-y-3 text-sm">{shared.map((row) => <div><dt class="inline font-black">{row.label}:</dt> <dd class="inline">{row.value}. <span class="text-ink/60">Fuentes: {row.facts.map(({beach, fact}, index) => <>{index > 0 && ', '}{fact?.sourceUrl ? <a class="underline" href={fact.sourceUrl} rel="noopener noreferrer">carta de {beach.name}</a> : beach.name}</>)}.</span></dd></div>)}</dl>
      </div>}

      <Sources sources={sources} />
    </div>
  </section>
</BaseLayout>
