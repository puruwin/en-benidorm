---
import Breadcrumbs from '../../components/Breadcrumbs.astro'
import LastVerified from '../../components/LastVerified.astro'
import Sources from '../../components/Sources.astro'
import BaseLayout from '../../layouts/BaseLayout.astro'
import {getComparisonBySlug, getComparisonSlugs} from '../../lib/content-source'
import {breadcrumbJsonLd, comparisonItemListJsonLd} from '../../lib/jsonld'
import type {BreadcrumbItem} from '../../types/content'

export async function getStaticPaths() {
  const slugs = await getComparisonSlugs()
  return slugs.map((slug) => ({params: {slug}}))
}

const {slug} = Astro.params
const comparison = slug ? await getComparisonBySlug(slug) : null
if (!comparison) throw new Error(`No se encontró la comparativa estática: ${slug ?? 'sin slug'}`)
const breadcrumbs: BreadcrumbItem[] = [{label: 'Inicio', href: '/'}, {label: 'Dónde comer', href: '/donde-comer/'}, {label: comparison.title}]
const site = Astro.site ?? new URL('https://enbenidorm.es')
const showPrice = comparison.entries.some((entry) => entry.featuredPrice)
const showPractical = comparison.entries.some((entry) => entry.practicalNotes.length > 0)
---

<BaseLayout seo={comparison.seo} jsonLd={[breadcrumbJsonLd(breadcrumbs, site), comparisonItemListJsonLd(comparison, site)]} demo={false}>
  <article>
    <header class="bg-sand pb-14 pt-8 md:pb-20">
      <div class="container-site">
        <Breadcrumbs items={breadcrumbs} />
        <p class="mt-12 text-xs font-black uppercase tracking-[.18em] text-coral">Comparativa local · {comparison.topic}</p>
        <h1 class="font-editorial mt-3 max-w-5xl text-5xl leading-[.95] tracking-[-.045em] md:text-7xl">{comparison.title}</h1>
        <p class="mt-7 max-w-3xl text-lg leading-relaxed text-ink/75">{comparison.intro}</p>
      </div>
    </header>

    <div class="container-site py-12 md:py-16">
      <section class="rounded-[1.75rem] bg-sea-dark p-7 text-white md:p-10" aria-labelledby="quick-verdict-title">
        <p class="text-xs font-black uppercase tracking-[.18em] text-sky">En pocas palabras</p>
        <h2 id="quick-verdict-title" class="font-editorial mt-2 text-3xl">Veredicto rápido</h2>
        <p class="mt-4 max-w-4xl text-base leading-relaxed text-white/85 md:text-lg">{comparison.quickVerdict}</p>
      </section>

      <section class="mt-14" aria-labelledby="comparison-table-title">
        <h2 id="comparison-table-title" class="font-editorial text-3xl md:text-4xl">Comparación rápida</h2>
        <div class="mt-6 overflow-x-auto rounded-2xl border border-ink/10">
          <table class="w-full min-w-[44rem] border-collapse text-left text-sm">
            <thead class="bg-sand text-xs uppercase tracking-[.1em] text-ink/60"><tr><th class="p-4">#</th><th class="p-4">Restaurante</th><th class="p-4">Destaca por</th>{showPrice && <th class="p-4">Precio / referencia</th>}{showPractical && <th class="p-4">Dato práctico</th>}</tr></thead>
            <tbody>{comparison.entries.map((entry) => <tr class="border-t border-ink/10 align-top"><td class="p-4 font-black text-coral">{entry.rank}</td><td class="p-4"><a class="font-bold text-sea-dark underline" href={entry.business.href}>{entry.business.name}</a></td><td class="p-4">{entry.strengths[0]}</td>{showPrice && <td class="p-4">{entry.featuredPrice ?? '—'}</td>}{showPractical && <td class="p-4">{entry.practicalNotes[0] ?? '—'}</td>}</tr>)}</tbody>
          </table>
        </div>
      </section>

      <section class="mt-16 space-y-8" aria-labelledby="entries-title">
        <h2 id="entries-title" class="font-editorial text-3xl md:text-4xl">Uno por uno</h2>
        {comparison.entries.map((entry) => (
          <article class="rounded-[1.75rem] border border-ink/10 bg-white p-6 shadow-[0_12px_40px_rgba(16,47,59,.05)] md:p-9" aria-labelledby={`entry-${entry.rank}`}>
            <div class="flex flex-wrap items-start justify-between gap-4"><div><p class="text-xs font-black uppercase tracking-[.14em] text-coral">Puesto {entry.rank}</p><h3 id={`entry-${entry.rank}`} class="font-editorial mt-1 text-3xl md:text-4xl">{entry.business.name}</h3></div><div class="flex flex-wrap gap-2">{entry.bestFor.map((tag) => <span class="rounded-full bg-sky px-3 py-1 text-xs font-bold text-sea-dark">{tag}</span>)}</div></div>
            <p class="mt-5 max-w-3xl leading-relaxed text-ink/75">{entry.verdict}</p>
            <div class="mt-7 grid gap-7 md:grid-cols-2">
              <div><h4 class="text-xs font-black uppercase tracking-[.13em] text-sea-dark">Puntos fuertes</h4><ul class="mt-3 space-y-2">{entry.strengths.map((strength) => <li class="flex gap-2"><span aria-hidden="true">+</span><span>{strength}</span></li>)}</ul></div>
              {entry.weaknesses.length > 0 && <div><h4 class="text-xs font-black uppercase tracking-[.13em] text-ink/55">Inconvenientes documentados</h4><ul class="mt-3 space-y-2">{entry.weaknesses.map((weakness) => <li>{weakness}</li>)}</ul></div>}
            </div>
            {(entry.featuredItem || entry.featuredPrice || entry.practicalNotes.length > 0) && <dl class="mt-7 grid gap-4 border-t border-ink/10 pt-6 text-sm md:grid-cols-3">{entry.featuredItem && <div><dt class="font-black uppercase tracking-[.1em] text-ink/50">Plato de referencia</dt><dd class="mt-1 font-bold">{entry.featuredItem}</dd></div>}{entry.featuredPrice && <div><dt class="font-black uppercase tracking-[.1em] text-ink/50">Precio comprobado</dt><dd class="mt-1 font-bold">{entry.featuredPrice}</dd></div>}{entry.practicalNotes.length > 0 && <div><dt class="font-black uppercase tracking-[.1em] text-ink/50">En la práctica</dt><dd class="mt-1">{entry.practicalNotes.join(' · ')}</dd></div>}</dl>}
            <div class="mt-7 flex flex-wrap gap-4 text-sm"><a class="rounded-full bg-ink px-5 py-2 font-bold text-white" href={entry.business.href}>Ver ficha</a>{entry.business.phone && <a class="font-bold text-sea-dark underline" href={`tel:${entry.business.phone.replace(/\s/g, '')}`}>{entry.business.phone}</a>}{entry.business.website && <a class="font-bold text-sea-dark underline" href={entry.business.website} rel="noopener noreferrer">Web oficial ↗</a>}</div>
          </article>
        ))}
      </section>

      <div class="mt-16 grid gap-12 lg:grid-cols-[minmax(0,1fr)_22rem]">
        <section aria-labelledby="methodology-title"><h2 id="methodology-title" class="font-editorial text-3xl md:text-4xl">Cómo hacemos esta comparativa</h2><p class="mt-5 leading-relaxed text-ink/75">{comparison.methodology}</p><h3 class="font-editorial mt-8 text-2xl">Criterios utilizados</h3><ul class="mt-4 space-y-3">{comparison.criteria.map((criterion) => <li class="border-l-2 border-coral pl-4">{criterion}</li>)}</ul><Sources sources={comparison.sources} /></section>
        <aside class="h-fit rounded-2xl bg-sand p-6"><LastVerified date={comparison.lastVerified} /><p class="mt-6 text-xs font-black uppercase tracking-[.13em] text-ink/50">Autor</p><p class="mt-2 font-bold"><a class="text-sea-dark underline" href={`/sobre-${comparison.author.slug}/`}>{comparison.author.name}</a></p>{comparison.author.role && <p class="mt-1 text-sm text-ink/65">{comparison.author.role}</p>}<p class="mt-6 text-sm"><a class="font-bold text-sea-dark underline" href="/donde-comer/">Volver a Dónde comer</a></p></aside>
      </div>
    </div>
  </article>
</BaseLayout>
