---
import Breadcrumbs from '../../components/Breadcrumbs.astro'
import Sources from '../../components/Sources.astro'
import BaseLayout from '../../layouts/BaseLayout.astro'
import {factValue, formatRetrievedAt, pendingText, unconfirmedSourceText} from '../../lib/beach-presentation'
import {getGuideHubContent} from '../../lib/content-source'
import {findGuideFact, guideFactLabel} from '../../lib/guide-presentation'
import {structuralIndexability} from '../../lib/indexability'
import {HUBS, breadcrumbTrail, getRouteRegistry, routes} from '../../lib/routes'
import type {PracticalFactView, SourceItem} from '../../types/content'

const content = await getGuideHubContent('informationPractical')
const registry = await getRouteRegistry()
const breadcrumbs = breadcrumbTrail(null, HUBS.informationPractical.label, registry)

// Visión general: por guía, los hechos que más ayudan a decidir. Cada uno sale de los hechos citados
// por la propia guía, así que hub y guía muestran siempre el mismo valor y el mismo estado.
const OVERVIEW: Record<string, string[]> = {
  'zona-azul-benidorm': ['zona-azul.horario.verano-visitantes', 'zona-azul.horario.invierno-visitantes', 'zona-azul.estancia-maxima', 'zona-azul.tarifa'],
  'aparcamientos-gratuitos-benidorm': ['aparcamientos-disuasorios.plazas', 'aparcamientos-disuasorios.mayores', 'aparcamiento-beniarda.plazas', 'aparcamientos-disuasorios.autobus', 'aparcamientos-disuasorios.autobus-vigencia'],
  'zona-bajas-emisiones-benidorm': ['zbe.acceso-libre', 'zbe.hoteles', 'zbe.matricula-extranjera', 'zbe.moratoria-sin-distintivo'],
}
const overview = content.guides.map((guide) => ({
  guide,
  facts: (OVERVIEW[guide.slug] ?? []).flatMap((id) => {
    const fact = findGuideFact(guide.facts, id)
    return fact ? [fact] : []
  }),
}))

// Sin coche: autobús y TRAM, tal como los cita la guía de aparcamientos gratuitos.
const transitIds = ['autobus-urbano.tarifa', 'autobus-urbano.tarjeta-bus', 'autobus-urbano.transbordo', 'autobus-urbano.titulos-turisticos', 'tram.tarifa-sencillo']
const transitGuide = content.guides.find((guide) => transitIds.some((id) => findGuideFact(guide.facts, id)))
const transit = transitGuide ? transitIds.flatMap((id) => findGuideFact(transitGuide.facts, id) ?? []) : []

const confirmed = content.guides.flatMap((guide) => guide.facts.filter((fact) => fact.status === 'confirmed' && fact.retrievedAt))
const updated = confirmed.map((fact) => fact.retrievedAt!).sort().at(-1) ?? null
const sources = [...new Map(content.guides.flatMap((guide) => guide.sources).map((source): [string, SourceItem] => [source.url, source])).values()]
const value = (fact: PracticalFactView) => factValue(fact)
---

<BaseLayout seo={content.seo} indexability={structuralIndexability({subject: HUBS.informationPractical.label, h1: content.title, storedNoIndex: content.seo.noIndex, title: content.seo.title})} breadcrumbs={breadcrumbs}>
  <header class="bg-sand py-10 md:py-16">
    <div class="container-site">
      <Breadcrumbs items={breadcrumbs} />
      <p class="mt-12 text-xs font-black uppercase tracking-[.18em] text-coral">Aparcar y moverse</p>
      <h1 class="font-editorial mt-2 max-w-4xl text-5xl leading-[.98] tracking-[-.045em] md:text-7xl">{content.title}</h1>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-ink/70">{content.intro}</p>
      {updated && <p class="mt-6 inline-flex rounded-full bg-sky px-4 py-2 text-xs font-bold text-sea-dark">Fuentes municipales consultadas el&nbsp;<time datetime={updated.slice(0, 10)}>{formatRetrievedAt(updated)}</time></p>}
    </div>
  </header>

  <section class="py-14 md:py-20" aria-labelledby="choose-title">
    <div class="container-site">
      <h2 id="choose-title" class="font-editorial text-3xl md:text-4xl">Tres guías para llegar en coche</h2>
      <ul class="mt-7 grid gap-4 md:grid-cols-3">{content.guides.map((guide) => <li class="rounded-2xl border border-ink/10 bg-white p-6 shadow-[0_12px_40px_rgba(16,47,59,.05)]">
        <h3 class="font-editorial text-2xl"><a class="text-sea-dark underline" href={guide.href}>{guide.title.split(':')[0]}</a></h3>
        <p class="mt-3 text-sm leading-relaxed text-ink/80">{guide.excerpt}</p>
      </li>)}</ul>
    </div>
  </section>

  <section class="pb-14 md:pb-20" aria-labelledby="overview-title">
    <div class="container-site">
      <h2 id="overview-title" class="font-editorial text-3xl md:text-4xl">Lo esencial de cada una</h2>
      <p class="mt-3 max-w-2xl text-ink/70">Los datos que más ayudan a decidir, con su fuente. Cada guía tiene el resto.</p>
      <div class="mt-8 grid gap-6 lg:grid-cols-3">{overview.map(({guide, facts}) => <section class="rounded-2xl border border-ink/10 bg-white p-6" aria-labelledby={`overview-${guide.slug}`}>
        <h3 id={`overview-${guide.slug}`} class="font-editorial text-2xl"><a class="text-sea-dark underline" href={guide.href}>{guide.title.split(':')[0]}</a></h3>
        <dl class="mt-4 space-y-4 text-sm">{facts.map((fact) => <div data-fact-id={fact.factId}>
          <dt class="font-black text-ink/60">{guideFactLabel(fact)}</dt>
          <dd class="mt-1">{value(fact) ? <span>{value(fact)}</span> : <span class="font-bold text-coral">{pendingText(fact)}</span>}{fact.status === 'confirmed' && fact.sourceUrl ? <a class="mt-1 block text-xs text-ink/50 underline" href={fact.sourceUrl} rel="noopener noreferrer">{fact.sourceTitle ?? 'Fuente'}</a> : unconfirmedSourceText(fact) && <span class="mt-1 block text-xs text-ink/50">{unconfirmedSourceText(fact)}</span>}</dd>
        </div>)}</dl>
      </section>)}</div>
    </div>
  </section>

  {transit.length > 0 && transitGuide && <section class="pb-14 md:pb-20" aria-labelledby="transit-title">
    <div class="container-site">
      <h2 id="transit-title" class="font-editorial text-3xl md:text-4xl">Moverse sin coche</h2>
      <p class="mt-3 max-w-2xl text-ink/70">Desde los aparcamientos gratuitos se puede seguir a pie o en el autobús urbano. Lo que no tiene fuente oficial queda pendiente y sin cifra.</p>
      <dl class="mt-6 max-w-3xl divide-y divide-ink/10 border-y border-ink/10 text-sm">{transit.map((fact) => <div class="grid gap-1 py-4 sm:grid-cols-[14rem_minmax(0,1fr)] sm:gap-6" data-fact-id={fact.factId}>
        <dt class="font-black text-ink/60">{guideFactLabel(fact)}</dt>
        <dd>{value(fact) ? <span class="font-bold">{value(fact)}</span> : <span class="font-bold text-coral">{pendingText(fact)}</span>}{fact.status === 'confirmed' && fact.sourceUrl ? <a class="mt-1 block text-xs text-ink/50 underline" href={fact.sourceUrl} rel="noopener noreferrer">{fact.sourceTitle ?? 'Fuente'}</a> : unconfirmedSourceText(fact) && <span class="mt-1 block text-xs text-ink/50">{unconfirmedSourceText(fact)}</span>}</dd>
      </div>)}</dl>
      <p class="mt-4 text-sm"><a class="font-bold text-sea-dark underline" href={transitGuide.href}>Cómo combinar aparcamiento gratuito y autobús</a></p>
    </div>
  </section>}

  {registry.has(routes.beaches()) && <section class="pb-14 md:pb-20" aria-labelledby="beaches-title">
    <div class="container-site">
      <h2 id="beaches-title" class="font-editorial text-3xl md:text-4xl">Si vas a la playa</h2>
      <p class="mt-3 max-w-2xl text-ink/70">El aparcamiento documentado junto a cada playa y las plazas reservadas de los puntos accesibles están en sus fichas.</p>
      <a class="mt-3 inline-block font-bold text-sea-dark underline" href={routes.beaches()}>Ver las playas de Benidorm</a>
    </div>
  </section>}

  <div class="container-site pb-16"><Sources sources={sources} /></div>
</BaseLayout>
