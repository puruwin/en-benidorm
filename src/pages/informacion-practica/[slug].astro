---
import Breadcrumbs from '../../components/Breadcrumbs.astro'
import PracticalFacts from '../../components/PracticalFacts.astro'
import Sources from '../../components/Sources.astro'
import BaseLayout from '../../layouts/BaseLayout.astro'
import {formatRetrievedAt, pendingText, unconfirmedSourceText} from '../../lib/beach-presentation'
import {getInformationGuideBySlug, getInformationGuideSlugs} from '../../lib/content-source'
import {guideFactGroups, guidePendingFacts} from '../../lib/guide-presentation'
import {guideIndexability} from '../../lib/indexability'
import {guideJsonLd} from '../../lib/jsonld'
import {HUBS, breadcrumbTrail, filterLinks, getRouteRegistry, routes} from '../../lib/routes'

export async function getStaticPaths() {
  const slugs = await getInformationGuideSlugs()
  return slugs.map((slug) => ({params: {slug}}))
}

const {slug} = Astro.params
const guide = slug ? await getInformationGuideBySlug(slug) : null
if (!guide) throw new Error(`No se encontró la guía estática: ${slug ?? 'sin slug'}`)
const item = guide
const registry = await getRouteRegistry()
const breadcrumbs = breadcrumbTrail('informationPractical', item.title.split(':')[0]!.trim(), registry)
const site = Astro.site ?? new URL('https://enbenidorm.es')
const groups = guideFactGroups(item.facts)
const pending = guidePendingFacts(item.facts)
const links = filterLinks(item.links, registry, `guía ${item.slug}`)
---

<BaseLayout seo={item.seo} indexability={guideIndexability(item)} seoFallback={{title: item.title, description: item.excerpt}} breadcrumbs={breadcrumbs} jsonLd={[guideJsonLd(item, site)]}>
  <article>
    <header class="bg-sand pb-12 pt-8 md:pb-16">
      <div class="container-site">
        <Breadcrumbs items={breadcrumbs} />
        <p class="mt-12 text-xs font-black uppercase tracking-[.14em] text-sea-dark">{HUBS.informationPractical.label} · Aparcar y moverse</p>
        <h1 class="font-editorial mt-3 max-w-5xl text-4xl leading-[.98] tracking-[-.04em] md:text-6xl">{item.title}</h1>
        <p class="mt-6 max-w-3xl text-lg leading-relaxed text-ink/70">{item.excerpt}</p>
        <p class="mt-4 text-sm text-ink/60">Por <a class="font-bold text-sea-dark underline" href={`/sobre-${item.author.slug}/`}>{item.author.name}</a> · publicada el <time datetime={item.publishedAt.slice(0, 10)}>{formatRetrievedAt(item.publishedAt)}</time>{item.updatedAt && <> · actualizada el <time datetime={item.updatedAt.slice(0, 10)}>{formatRetrievedAt(item.updatedAt)}</time></>}</p>
      </div>
    </header>

    <div class="container-site grid gap-12 py-10 lg:grid-cols-[minmax(0,1fr)_22rem]">
      <div>
        {item.description.length > 0 && <div class="prose-editorial">{item.description.map((block) => <p>{block.text}</p>)}</div>}

        {groups.map((group) => <section class="mt-12" aria-labelledby={`${group.id}-title`}>
          <h2 id={`${group.id}-title`} class="font-editorial text-3xl">{group.title}</h2>
          <div class="mt-4"><PracticalFacts rows={group.rows} /></div>
        </section>)}

        {pending.length > 0 && <section class="mt-12 rounded-2xl border border-coral/30 bg-coral/5 p-6" aria-labelledby="pending-title">
          <h2 id="pending-title" class="font-editorial text-2xl">Lo que aún no hemos comprobado</h2>
          <p class="mt-2 text-sm text-ink/70">Estos datos no tienen todavía una fuente oficial actual o piden una observación en persona que no hemos hecho. Mientras tanto no damos la cifra ni el dato.</p>
          <ul class="mt-4 space-y-3 text-sm">{pending.map((row) => <li data-fact-id={row.fact.factId}><span class="font-bold">{row.label}:</span> {pendingText(row.fact)}{unconfirmedSourceText(row.fact) && <span class="block text-xs text-ink/60">{unconfirmedSourceText(row.fact)}</span>}</li>)}</ul>
        </section>}

        <Sources sources={item.sources} />
      </div>

      <aside class="h-fit space-y-8 rounded-[1.5rem] border border-ink/10 bg-white p-6 shadow-[0_12px_40px_rgba(16,47,59,.06)]">
        {links.length > 0 && <section aria-labelledby="next-title">
          <h2 id="next-title" class="font-editorial text-2xl">Según tu caso</h2>
          <ul class="mt-4 space-y-4 text-sm">{links.map((link) => <li><a class="font-bold text-sea-dark underline" href={link.href}>{link.title}</a><p class="mt-1 text-ink/70">{link.note}</p></li>)}</ul>
        </section>}
        <section class="border-t border-ink/10 pt-6" aria-labelledby="hub-title">
          <h2 id="hub-title" class="font-editorial text-2xl">Aparcar y moverse</h2>
          <p class="mt-2 text-sm text-ink/70">Zona azul, aparcamientos gratuitos y zona de bajas emisiones, lo esencial de cada una en una página.</p>
          <a class="mt-3 inline-block font-bold text-sea-dark underline" href={routes.informationPractical()}>Ver {HUBS.informationPractical.label.toLowerCase()} de Benidorm</a>
        </section>
      </aside>
    </div>
  </article>
</BaseLayout>
