---
import GuideArticle from '../../components/GuideArticle.astro'
import {getGuideBySlug, getGuideSlugs} from '../../lib/content-source'

export async function getStaticPaths() {
  const slugs = await getGuideSlugs('informationPractical')
  return slugs.map((slug) => ({params: {slug}}))
}

const {slug} = Astro.params
const guide = slug ? await getGuideBySlug('informationPractical', slug) : null
if (!guide) throw new Error(`No se encontró la guía estática: ${slug ?? 'sin slug'}`)
---

<GuideArticle guide={guide} hub="informationPractical" topic="Aparcar y moverse" hubSummary="Zona azul, aparcamientos gratuitos y zona de bajas emisiones, lo esencial de cada una en una página." hubLinkText="Ver información práctica de Benidorm" />
