---
import type {EditorialImage} from '../types/content'
import ImageCredit from './media/ImageCredit.astro'
import ResponsiveImage from './media/ResponsiveImage.astro'
import {imageCredit} from '../lib/image-credit'
interface Props { images: EditorialImage[]; label?: string }
const {images, label = 'Galería de imágenes'} = Astro.props
---

{images.length > 0 && <div role="group" aria-label={label} class="grid gap-3 sm:grid-cols-2">
  {images.map((image, index) => <figure class:list={["overflow-hidden rounded-2xl bg-sand", index === 0 && images.length > 2 ? "sm:col-span-2" : ""]}>
    <ResponsiveImage image={image} class="aspect-[16/10] h-full w-full object-cover" sizes={index === 0 ? '100vw' : '(min-width: 640px) 50vw, 100vw'} />
    {(image.caption || imageCredit(image)) && <figcaption class="px-3 py-2 text-xs text-ink/65">{image.caption && <span data-image-caption>{image.caption}</span>}{image.caption && imageCredit(image) && ' · '}<ImageCredit image={image} /></figcaption>}
  </figure>)}
</div>}
