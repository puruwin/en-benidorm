---
import type {SeoData} from '../../types/content'

interface Props { seo: SeoData; canonical: URL }
const {seo, canonical} = Astro.props
const image = seo.image?.url ? new URL(seo.image.url, canonical).toString() : undefined
---

<title>{seo.title}</title>
<meta name="description" content={seo.description} />
<link rel="canonical" href={canonical} />
<meta name="robots" content={seo.noIndex ? 'noindex,follow' : 'index,follow'} />
<meta property="og:type" content="website" />
<meta property="og:locale" content="es_ES" />
<meta property="og:site_name" content="enBenidorm" />
<meta property="og:title" content={seo.title} />
<meta property="og:description" content={seo.description} />
<meta property="og:url" content={canonical} />
{image && <meta property="og:image" content={image} />}
{image && <meta property="og:image:alt" content={seo.image?.alt} />}
<meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
<meta name="twitter:title" content={seo.title} />
<meta name="twitter:description" content={seo.description} />
{image && <meta name="twitter:image" content={image} />}
