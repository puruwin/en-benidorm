---
import type {SourceItem} from '../types/content'
interface Props { sources: SourceItem[] }
const {sources} = Astro.props
---

{sources.length > 0 && <section aria-labelledby="sources-title" class="mt-12 border-t border-ink/15 pt-8">
  <h2 id="sources-title" class="font-editorial text-2xl">Fuentes</h2>
  <ul class="mt-4 space-y-2 text-sm text-ink/70">{sources.map((source) => <li><a class="font-bold text-sea-dark underline" href={source.url} rel="noopener noreferrer">{source.title}</a>{source.publisher && ` · ${source.publisher}`}{source.accessedAt && ` · consultada ${source.accessedAt}`}</li>)}</ul>
</section>}
