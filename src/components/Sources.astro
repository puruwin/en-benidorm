---
import type {SourceItem} from '../types/content'
import {groupPublicSources} from '../lib/comparison-presentation'
interface Props { sources: SourceItem[]; grouped?: boolean }
const {sources, grouped = false} = Astro.props
const groups = groupPublicSources(sources)
---

{sources.length > 0 && grouped && <section aria-labelledby="sources-title" class="mt-12 border-t border-ink/15 pt-8">
  <h2 id="sources-title" class="font-editorial text-3xl md:text-4xl">Fuentes consultadas</h2>
  <div class="mt-6 grid gap-6 sm:grid-cols-2">{groups.map((group) => <div><h3 class="font-bold text-ink">{group.name}</h3><ul class="mt-2 flex flex-wrap gap-2 text-sm">{group.sources.map((source) => <li><a class="inline-flex rounded-full border border-ink/15 bg-white px-3 py-1.5 font-bold text-sea-dark underline decoration-sea-dark/30 underline-offset-2" href={source.url} rel="noopener noreferrer">{source.label}<span class="sr-only"> de {group.name}</span></a></li>)}</ul></div>)}</div>
</section>}

{sources.length > 0 && !grouped && <section aria-labelledby="sources-title" class="mt-12 border-t border-ink/15 pt-8">
  <h2 id="sources-title" class="font-editorial text-2xl">Fuentes</h2>
  <ul class="mt-4 space-y-2 text-sm text-ink/70">{sources.map((source) => <li><a class="font-bold text-sea-dark underline" href={source.url} rel="noopener noreferrer">{source.title}</a>{source.publisher && ` · ${source.publisher}`}{source.accessedAt && ` · consultada ${source.accessedAt}`}</li>)}</ul>
</section>}
