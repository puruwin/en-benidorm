---
import type {FactRow} from '../lib/beach-presentation'
import {formatRetrievedAt, pendingText, unconfirmedSourceText} from '../lib/beach-presentation'
// Lista de hechos prácticos con su procedencia: valor, fuente enlazada y fecha de consulta.
// Si todas las filas están confirmadas con la misma fuente y fecha, la fuente se muestra una vez al final.
interface Props { rows: FactRow[] }
const {rows} = Astro.props
const first = rows[0]?.fact
const shared = rows.length > 1 && first?.sourceUrl && first.sourceTitle
  && rows.every(({fact}) => fact.status === 'confirmed' && fact.sourceUrl === first.sourceUrl && fact.retrievedAt === first.retrievedAt)
  ? first : null
---
{rows.length > 0 && <dl class="divide-y divide-ink/10 border-y border-ink/10">
  {rows.map(({fact, label, value}) => <div class="grid gap-1 py-4 sm:grid-cols-[12rem_minmax(0,1fr)] sm:gap-6" data-fact-id={fact.factId}>
    <dt class="text-sm font-black text-ink/60">{label}</dt>
    <dd>
      {value ? <p class="font-bold leading-snug">{value}</p> : <p class="font-bold text-coral">{pendingText(fact)}</p>}
      {fact.status !== 'confirmed' && fact.sourceTitle && <p class="mt-1 text-xs text-ink/60">{unconfirmedSourceText(fact)}</p>}
      {!shared && fact.status === 'confirmed' && fact.sourceUrl && fact.sourceTitle && <p class="mt-1 text-xs text-ink/60">Fuente: <a class="underline decoration-ink/30 underline-offset-2" href={fact.sourceUrl} rel="noopener noreferrer">{fact.sourceTitle}</a>{fact.retrievedAt && <>, consultada el <time datetime={fact.retrievedAt.slice(0, 10)}>{formatRetrievedAt(fact.retrievedAt)}</time></>}</p>}
    </dd>
  </div>)}
</dl>}
{shared && <p class="mt-2 text-xs text-ink/60">Fuente: <a class="underline decoration-ink/30 underline-offset-2" href={shared.sourceUrl!} rel="noopener noreferrer">{shared.sourceTitle}</a>{shared.retrievedAt && <>, consultada el <time datetime={shared.retrievedAt.slice(0, 10)}>{formatRetrievedAt(shared.retrievedAt)}</time></>}</p>}
