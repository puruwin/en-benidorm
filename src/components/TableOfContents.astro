---
interface Heading { id: string; text: string; depth?: 2 | 3 }
interface Props { headings: Heading[] }
const {headings} = Astro.props
---

{headings.length > 0 && <nav aria-labelledby="toc-title" class="rounded-2xl border border-ink/10 bg-white p-5">
  <h2 id="toc-title" class="text-sm font-black uppercase tracking-[.15em] text-sea-dark">En esta página</h2>
  <ol class="mt-3 space-y-2 text-sm">{headings.map((heading) => <li class:list={[heading.depth === 3 && 'pl-4']}><a class="hover:text-sea hover:underline" href={`#${heading.id}`}>{heading.text}</a></li>)}</ol>
</nav>}
