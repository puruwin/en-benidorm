---
import type {BusinessSummary} from '../types/content'
import ResponsiveImage from './media/ResponsiveImage.astro'
interface Props { business: BusinessSummary }
const {business} = Astro.props
---

<article class="group relative flex h-full flex-col overflow-hidden rounded-[1.5rem] border border-ink/10 bg-white shadow-[0_12px_40px_rgba(16,47,59,.07)]">
  {business.image ? <div class="aspect-[4/3] overflow-hidden bg-sky"><ResponsiveImage image={business.image} class="h-full w-full object-cover transition duration-500 group-hover:scale-[1.03]" sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw" /></div> : <div class="aspect-[4/3] bg-sky"></div>}
  <div class="flex flex-1 flex-col p-5">
    <div class="flex flex-wrap gap-2 text-[.68rem] font-black uppercase tracking-[.13em] text-sea-dark">
      <span>{business.kind}</span>{business.sponsored && <span class="rounded-full bg-sand px-2 py-0.5 text-ink">Patrocinado</span>}
    </div>
    <h3 class="mt-2 font-editorial text-2xl leading-tight"><a class="after:absolute after:inset-0" href={business.href}>{business.name}</a></h3>
    <p class="mt-3 text-sm leading-relaxed text-ink/70">{business.shortDescription}</p>
    <p class="mt-auto pt-5 text-xs font-bold text-ink/60">{[business.area, business.priceRange].filter(Boolean).join(' · ')}</p>
  </div>
</article>
