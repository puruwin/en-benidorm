---
import type {SiteSettingsData} from '../types/content'
interface Props { settings: SiteSettingsData }
const {settings} = Astro.props
const year = new Date().getFullYear()
---

<footer class="mt-20 bg-ink text-white">
  <div class="container-site grid gap-10 py-14 md:grid-cols-[1.4fr_1fr_1fr]">
    <div>
      <p class="text-2xl font-black tracking-[-.05em]"><span class="text-[#65d4cf]">en</span>Benidorm<span class="text-coral">.</span></p>
      <p class="mt-3 max-w-sm text-sm text-white/70">{settings.footerText}</p>
    </div>
    <div>
      <h2 class="text-sm font-black uppercase tracking-[.16em] text-[#65d4cf]">Explora</h2>
      <ul class="mt-3 space-y-2 text-sm">{settings.navigation.slice(0, 3).map((item) => <li><a href={item.href}>{item.label}</a></li>)}</ul>
    </div>
    <div>
      <h2 class="text-sm font-black uppercase tracking-[.16em] text-[#65d4cf]">Proyecto</h2>
      <p class="mt-3 text-sm text-white/70">Contenido verificado, fuentes visibles y recomendaciones claramente identificadas.</p>
    </div>
  </div>
  <div class="border-t border-white/10"><div class="container-site flex flex-wrap justify-between gap-2 py-5 text-xs text-white/55"><p>© {year} enBenidorm</p><p>Hecho para consultar caminando.</p></div></div>
</footer>
