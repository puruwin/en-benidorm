{
  "name": "en-benidorm",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "studio": "sanity dev",
    "studio:build": "sanity build sanity-dist",
    "studio:deploy": "sanity deploy",
    "content:seed": "node --import tsx scripts/seed-sanity.ts",
    "content:discover": "node --import tsx scripts/content/discover.ts",
    "content:enrich": "node --import tsx scripts/content/enrich.ts",
    "content:generate": "node --import tsx scripts/content/generate.ts",
    "content:qa": "node --import tsx scripts/content/qa.ts",
    "content:compare-quality": "node --import tsx scripts/content/quality-tier-comparison.ts",
    "seo:audit": "node --import tsx scripts/seo/audit-site.ts",
    "comparison:select": "node --import tsx scripts/comparison/select.ts",
    "comparison:enrich": "node --import tsx scripts/comparison/enrich.ts",
    "comparison:generate": "node --import tsx scripts/comparison/generate.ts",
    "comparison:qa": "node --import tsx scripts/comparison/qa.ts",
    "comparison:regression": "node --import tsx scripts/comparison/regression.ts",
    "content-lab": "node tools/content-lab/dev.mjs",
    "content-lab:hostinger": "node content-lab.server.mjs",
    "content-lab:doctor": "node --import tsx tools/content-lab/ops/doctor.ts",
    "content-lab:start": "node --import tsx tools/content-lab/api/src/production.ts",
    "content-lab:storage": "node tools/content-lab/ops/init-storage.mjs",
    "content-lab:password": "node tools/content-lab/ops/password.mjs",
    "content-lab:web": "vite --config tools/content-lab/web/vite.config.ts",
    "content-lab:api": "node --import tsx tools/content-lab/api/src/server.ts",
    "content-lab:build": "vite build --config tools/content-lab/web/vite.config.ts",
    "content-lab:test": "node --import tsx --test tools/content-lab/api/src/*.test.ts tools/content-lab/api/src/**/*.test.ts",
    "content:import": "node --import tsx scripts/import-content.ts",
    "content:validate": "node --import tsx scripts/validate-content.ts",
    "visit:process": "node --import tsx scripts/content/process-visit.ts",
    "test": "node --import tsx --test scripts/seo/*.test.ts scripts/content/*.test.ts scripts/content/**/*.test.ts scripts/comparison/**/*.test.ts tools/content-lab/api/src/*.test.ts tools/content-lab/api/src/**/*.test.ts",
    "sanity:schema:validate": "sanity schema validate",
    "sanity:schema:extract": "sanity schema extract --path schema.json --force",
    "typegen": "npm run sanity:schema:extract && sanity typegen generate"
  },
  "dependencies": {
    "@sanity/astro": "latest",
    "@sanity/client": "^8.9.0",
    "@sanity/image-url": "latest",
    "@tailwindcss/vite": "latest",
    "astro": "latest",
    "fastify": "^5.12.5",
    "groq": "latest",
    "parse5": "^8.0.1",
    "pdfjs-dist": "^6.4.299",
    "tailwindcss": "latest"
  },
  "devDependencies": {
    "@astrojs/check": "latest",
    "@astrojs/sitemap": "latest",
    "@sanity/vision": "6.17.0",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "^6.1.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sanity": "6.17.0",
    "styled-components": "^6.5.3",
    "tsx": "^4.23.15",
    "typescript": "latest",
    "vite": "^8.3.3"
  }
}
