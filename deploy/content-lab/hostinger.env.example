# Values to configure in the Node.js application settings, not in the frontend build.
CONTENT_LAB_ORIGIN=https://lab.enbenidorm.es
CONTENT_LAB_AUTH_USER=david
CONTENT_LAB_PASSWORD_HASH=
# REQUIRED: an absolute persistent directory outside the application release.
# Replace this illustrative path with the one supported by your hosting account.
CONTENT_LAB_CONTENT_PATH=/absolute/persistent/path/content
# Do not set CONTENT_LAB_PORT or PORT: use the provider's assigned PORT.

OPENAI_API_KEY=
OPENAI_CONTENT_MODEL=gpt-5-mini
OPENAI_COMPARISON_MODEL=gpt-5.6-luna
SANITY_PROJECT_ID=
SANITY_DATASET=production
SANITY_API_TOKEN=
