# Copy to app.env on the server. Never commit that file.
CONTENT_LAB_ORIGIN=https://lab.example.com
CONTENT_LAB_AUTH_USER=david
# Generate using npm run content-lab:password.
# Wrap the hash in SINGLE QUOTES so Compose preserves literal $ characters.
CONTENT_LAB_PASSWORD_HASH=''

# Optional server-side API integrations. Leave empty until needed.
OPENAI_API_KEY=
OPENAI_CONTENT_MODEL=gpt-5-mini
OPENAI_COMPARISON_MODEL=gpt-5.6-luna
SANITY_PROJECT_ID=
SANITY_DATASET=production
SANITY_API_TOKEN=
# Images (#23): dedicated Editor token "content-lab-images", distinct from SANITY_API_TOKEN.
# Only the images:import run receives it. Rotate it on any suspicion and when moving servers.
SANITY_IMAGES_TOKEN=
# Optional stock sources for images:find (Commons needs no key).
PIXABAY_API_KEY=
PEXELS_API_KEY=
