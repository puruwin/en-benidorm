# /etc/caddy/sites/enbenidorm.caddy
# Importar desde /etc/caddy/Caddyfile con:  import /etc/caddy/sites/*.caddy
# Validar:  caddy validate --config /etc/caddy/Caddyfile  ·  Aplicar:  systemctl reload caddy

(enbenidorm_headers) {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		-Server
	}
}

www.enbenidorm.es {
	redir https://enbenidorm.es{uri} permanent
}

enbenidorm.es {
	import enbenidorm_headers
	root * /srv/enbenidorm/site/current
	encode zstd gzip

	# Assets de Astro con hash en el nombre: inmutables. El resto, revalidar siempre.
	@hashed path /_astro/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	@unhashed not path /_astro/*
	header @unhashed Cache-Control "public, max-age=0, must-revalidate"

	file_server {
		hide .*
	}

	handle_errors {
		@notfound expression {err.status_code} == 404
		handle @notfound {
			rewrite * /404.html
			file_server
		}
		respond "{err.status_code} {err.status_text}"
	}

	log {
		output file /var/log/caddy/enbenidorm.log {
			roll_size 20MiB
			roll_keep 5
		}
	}
}

lab.enbenidorm.es {
	import enbenidorm_headers
	# El stream de logs (SSE) no se comprime: comprimirlo puede retrasar los eventos.
	@compressible not header Accept *text/event-stream*
	encode @compressible zstd gzip
	# Caddy conserva el Host original; Content Lab lo exige. SSE sin buffering.
	reverse_proxy 127.0.0.1:3000 {
		flush_interval -1
	}
}
