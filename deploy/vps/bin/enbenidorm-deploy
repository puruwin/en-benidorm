#!/usr/bin/env bash
# Único comando que puede ejecutar la clave SSH de GitHub Actions en la VPS.
# Se instala en /usr/local/bin/enbenidorm-deploy y se fuerza en authorized_keys:
#   restrict,command="/usr/local/bin/enbenidorm-deploy" ssh-ed25519 AAAA… github-actions-enbenidorm
#
# Órdenes (SSH_ORIGINAL_COMMAND):
#   site <sha40>    lee un tar.gz de dist/ por stdin y lo activa
#   lab <sha40>     lee un tar.gz del código (git archive) por stdin, instala, construye y reinicia
#   rollback-site   vuelve a la release anterior de la web
#   rollback-lab    vuelve a la release anterior de Content Lab
#   status          muestra releases activas
set -Eeuo pipefail
umask 022

SITE_ROOT=/srv/enbenidorm/site
LAB_ROOT=/srv/content-lab/app
LAB_SERVICE=content-lab.service
LAB_URL=http://127.0.0.1:3000/api/session
LAB_HOST=lab.enbenidorm.es
LOCK_FILE=/srv/enbenidorm/deploy.lock
KEEP_SITE=5
KEEP_LAB=3          # cada release de Content Lab lleva node_modules (~900 MB)
EX_TEMPFAIL=75      # despliegue pospuesto: Content Lab tiene trabajos activos

log() { printf '[%s] %s\n' "$(date -u +%FT%TZ)" "$*" >&2; }
die() { log "ERROR: $1"; exit "${2:-1}"; }

incoming=""
cleanup() { [[ -n "$incoming" && -d "$incoming" ]] && rm -rf -- "$incoming"; return 0; }
trap cleanup EXIT

read -r -a argv <<< "${SSH_ORIGINAL_COMMAND:-}"
action="${argv[0]:-}"
sha="${argv[1]:-}"
[[ ${#argv[@]} -le 2 ]] || die "Demasiados argumentos."

require_sha() { [[ "$sha" =~ ^[0-9a-f]{40}$ ]] || die "SHA no válido: '$sha'."; }

release_id() { printf '%s-%s' "$(date -u +%Y%m%dT%H%M%SZ)" "${sha:0:12}"; }

# Cambio atómico del enlace: los lectores ven la release vieja o la nueva, nunca nada.
switch_to() {
  local link=$1 target=$2
  ln -sfn -- "$target" "$link.next"
  mv -Tf -- "$link.next" "$link"
}

# Releases ordenadas de más nueva a más antigua (el id empieza por la fecha UTC).
releases() { find "$1" -mindepth 1 -maxdepth 1 -type d ! -name '.incoming-*' -printf '%f\n' | sort -r; }

prune() {
  local dir=$1 keep=$2 current; current=$(readlink -f "$3" || true)
  local old
  while read -r old; do
    [[ -z "$old" || "$dir/$old" -ef "$current" ]] && continue
    log "Eliminando release antigua $old"
    rm -rf -- "${dir:?}/$old"
  done < <(releases "$dir" | tail -n +"$((keep + 1))")
}

previous_release() {
  local dir=$1 current r; current=$(readlink -f "$2" || true)
  local seen=0
  while read -r r; do
    if [[ "$dir/$r" -ef "$current" ]]; then seen=1; continue; fi
    [[ $seen -eq 1 ]] && { printf '%s' "$r"; return 0; }
  done < <(releases "$dir")
  return 1
}

receive() {
  incoming="$1/.incoming-$2"
  mkdir -p -- "$incoming"
  tar -xzf - --no-same-owner --no-same-permissions -C "$incoming" || die "No se pudo extraer el paquete recibido."
}

# Procesos del servicio aparte del principal = pipelines en curso (Content Lab las lanza como hijos).
lab_active_runs() {
  local procs="/sys/fs/cgroup/system.slice/$LAB_SERVICE/cgroup.procs" n
  [[ -r "$procs" ]] || { echo 0; return; }
  n=$(grep -c . "$procs" || true)
  echo $(( n > 1 ? n - 1 : 0 ))
}

assert_lab_idle() {
  local n; n=$(lab_active_runs)
  [[ "$n" -eq 0 ]] || die "Content Lab tiene $n proceso(s) de pipeline activos. Despliegue pospuesto: relánzalo cuando terminen (Actions → Run workflow → lab)." "$EX_TEMPFAIL"
}

lab_healthy() {

  for _ in $(seq 1 30); do
    if curl -fsS -o /dev/null --max-time 5 -H "Host: $LAB_HOST" "$LAB_URL"; then return 0; fi
    sleep 2
  done
  return 1
}

# Para, hace backup del contenido, cambia de release y arranca. Si no arranca sano, vuelve atrás.
lab_activate() {
  local target=$1 previous; previous=$(readlink "$LAB_ROOT/current" || true)
  assert_lab_idle
  log "Deteniendo $LAB_SERVICE"
  sudo -n /usr/bin/systemctl stop "$LAB_SERVICE"
  log "Backup de content/"
  if ! sudo -n /usr/local/sbin/content-lab-backup; then
    sudo -n /usr/bin/systemctl start "$LAB_SERVICE" || true
    die "Falló el backup; Content Lab sigue en la release anterior."
  fi
  switch_to "$LAB_ROOT/current" "$target"
  sudo -n /usr/bin/systemctl start "$LAB_SERVICE"
  if lab_healthy; then
    log "Content Lab activo en $target"
    return 0
  fi
  log "Content Lab no responde en $target."
  if [[ -n "$previous" ]]; then
    sudo -n /usr/bin/systemctl stop "$LAB_SERVICE" || true
    switch_to "$LAB_ROOT/current" "$previous"
    sudo -n /usr/bin/systemctl start "$LAB_SERVICE" || true
    if lab_healthy; then
      log "Restaurada la release anterior $previous"
    else
      log "La release anterior tampoco responde: revisa journalctl -u $LAB_SERVICE"
    fi
  fi
  die "Despliegue de Content Lab fallido."
}

deploy_site() {
  require_sha
  local id; id=$(release_id)
  receive "$SITE_ROOT/releases" "$id"
  for f in index.html 404.html sitemap-index.xml robots.txt; do
    [[ -f "$incoming/$f" ]] || die "Falta $f en el paquete: no se activa."
  done
  chmod -R u=rwX,go=rX -- "$incoming"
  mv -T -- "$incoming" "$SITE_ROOT/releases/$id"; incoming=""
  switch_to "$SITE_ROOT/current" "releases/$id"
  log "Web activa: $id"
  prune "$SITE_ROOT/releases" "$KEEP_SITE" "$SITE_ROOT/current"
}

deploy_lab() {
  require_sha
  assert_lab_idle
  local id; id=$(release_id)
  receive "$LAB_ROOT/releases" "$id"
  [[ -f "$incoming/content-lab.server.mjs" && -f "$incoming/package-lock.json" ]] || die "El paquete no parece un checkout de en-benidorm."
  log "npm ci (incluye devDependencies: tsx se usa en ejecución)"
  ( cd "$incoming" && npm ci --include=dev --no-audit --no-fund --loglevel=error ) >&2
  log "npm run content-lab:build"
  ( cd "$incoming" && npm run content-lab:build ) >&2
  chmod -R go-w -- "$incoming"
  mv -T -- "$incoming" "$LAB_ROOT/releases/$id"; incoming=""
  lab_activate "releases/$id"
  prune "$LAB_ROOT/releases" "$KEEP_LAB" "$LAB_ROOT/current"
}

rollback_site() {
  local prev; prev=$(previous_release "$SITE_ROOT/releases" "$SITE_ROOT/current") || die "No hay release anterior de la web."
  switch_to "$SITE_ROOT/current" "releases/$prev"
  log "Web revertida a $prev"
}

rollback_lab() {
  local prev; prev=$(previous_release "$LAB_ROOT/releases" "$LAB_ROOT/current") || die "No hay release anterior de Content Lab."
  lab_activate "releases/$prev"
}

status() {
  printf 'web:          %s\n' "$(readlink "$SITE_ROOT/current" || echo '-')"
  printf 'content-lab:  %s\n' "$(readlink "$LAB_ROOT/current" || echo '-')"
  printf 'pipelines:    %s activas\n' "$(lab_active_runs)"
}

exec 9>"$LOCK_FILE"
flock -w 900 9 || die "Otro despliegue lleva más de 15 minutos en curso."

case "$action" in
  site) deploy_site ;;
  lab) deploy_lab ;;
  rollback-site) rollback_site ;;
  rollback-lab) rollback_lab ;;
  status) status ;;
  *) die "Orden no permitida: '${SSH_ORIGINAL_COMMAND:-}'." ;;
esac
